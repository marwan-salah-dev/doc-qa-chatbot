# Copy to backend/.env (next to this file) and fill in. Never commit .env.
# The app always loads backend/.env, whichever directory you run commands from.

# --- Chat model ---------------------------------------------------------
# Which provider answers questions: "anthropic" or "openai"
# ("openai" also covers OpenAI-compatible providers via OPENAI_BASE_URL below)
LLM_PROVIDER=anthropic
# Only the selected provider's key is required; the app refuses to start without it.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 balances quality and cost; claude-opus-5-5 is the higher-quality option
ANTHROPIC_MODEL=claude-sonnet-5-5
# Reasoning effort: low | medium | high | xhigh | max. "low" keeps chat answers fast and cheap.
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Leave empty for OpenAI itself. Set it to use an OpenAI-compatible provider; for Groq:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<your Groq key>
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
#   LLM_MAX_OUTPUT_TOKENS=2048
# gpt-oss is a reasoning model: its hidden reasoning counts toward LLM_MAX_OUTPUT_TOKENS, so
# give it more room than 1024 or answers can come back empty or cut off. Groq's free tier
# allows about 8K tokens per minute, which a few long questions in a row can use up.
OPENAI_BASE_URL=
# Seconds to wait for a response (for a stream: the longest gap between chunks)
LLM_TIMEOUT_SECONDS=60
# Retries on rate limits, server errors and dropped connections (before the answer starts)
LLM_MAX_RETRIES=2
# Longest answer the model may write, in tokens
LLM_MAX_OUTPUT_TOKENS=1024

# --- Embeddings ---------------------------------------------------------
# "local" = sentence-transformers on CPU (free, no key, ~1GB RAM)
# "openai" = text-embedding-3-small (needs OPENAI_API_KEY, low memory)
EMBEDDING_PROVIDER=local
# bge-small-en-v1.5: MIT licence, 384 dimensions, 512-token input limit
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chunking -----------------------------------------------------------
# Estimated tokens per chunk and how many are repeated between neighbouring chunks.
# Keep the size well under the embedding model's input limit (512 for bge-small) or the
# end of each chunk is silently cut off when it is embedded. Changing these means
# re-indexing existing documents.
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# --- Uploads ------------------------------------------------------------
# Largest PDF/DOCX/TXT upload accepted, in MB; bigger files get a 413 error. The app only
# checks after receiving the file, so the reverse proxy should enforce the same limit.
MAX_UPLOAD_MB=20

# --- Storage ------------------------------------------------------------
DATA_DIR=./data
# Leave empty to use an embedded Chroma in DATA_DIR; set for the Docker service
CHROMA_HOST=
CHROMA_PORT=8000

# --- Web ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# Required for admin-only operations on the public demo
ADMIN_API_KEY=

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
# true = one JSON object per line (for servers); false = readable text (for local dev)
LOG_JSON=true
