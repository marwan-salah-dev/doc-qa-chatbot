# Copy to backend/.env (next to this file) and fill in. Never commit .env.
# The app always loads backend/.env, whichever directory you run commands from.

# --- Chat model ---------------------------------------------------------
# Which provider answers questions: "anthropic" or "openai"
# ("openai" also covers OpenAI-compatible providers via OPENAI_BASE_URL below)
LLM_PROVIDER=anthropic
# Only the selected provider's key is required; the app refuses to start without it.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 balances quality and cost; claude-opus-5-5 is the higher-quality option
ANTHROPIC_MODEL=claude-sonnet-5-5
# Reasoning effort: low | medium | high | xhigh | max. "low" keeps chat answers fast and cheap.
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Leave empty for OpenAI itself. Set it to use an OpenAI-compatible provider; for Groq:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<your Groq key>
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
#   LLM_MAX_OUTPUT_TOKENS=2048
# gpt-oss is a reasoning model: its hidden reasoning counts toward LLM_MAX_OUTPUT_TOKENS, so
# give it more room than 1024 or answers can come back empty or cut off. Groq's free tier
# allows about 8K tokens per minute, which a few long questions in a row can use up.
OPENAI_BASE_URL=
# Seconds to wait for a response (for a stream: the longest gap between chunks)
LLM_TIMEOUT_SECONDS=60
# Retries on rate limits, server errors and dropped connections (before the answer starts)
LLM_MAX_RETRIES=2
# Longest answer the model may write, in tokens
LLM_MAX_OUTPUT_TOKENS=1024

# --- Embeddings ---------------------------------------------------------
# "local" = sentence-transformers on CPU (free, no key, ~1GB RAM)
# "openai" = text-embedding-3-small (needs OPENAI_API_KEY, low memory)
EMBEDDING_PROVIDER=local
# bge-small-en-v1.5: MIT licence, 384 dimensions, 512-token input limit
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chunking -----------------------------------------------------------
# Estimated tokens per chunk and how many are repeated between neighbouring chunks.
# Keep the size well under the embedding model's input limit (512 for bge-small) or the
# end of each chunk is silently cut off when it is embedded. Changing these means
# re-indexing existing documents.
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# --- Answering ----------------------------------------------------------
# How many chunks to retrieve per question
RAG_TOP_K=6
# Cosine similarity (0..1) a chunk needs to count as relevant. If none reaches it, the app
# answers "I couldn't find this in your documents" without calling the LLM. 0.45 is for
# bge-small; OpenAI embeddings score lower and usually want about 0.3. It errs low on purpose:
# the LLM's NOT_FOUND instruction is the backstop for anything that slips through, while a
# threshold set too high wrongly refuses real questions.
RAG_MIN_SCORE=0.45
# Most tokens one answer call may use: instructions + history + sources + question, plus
# LLM_MAX_OUTPUT_TOKENS reserved for the reply (so it must be larger than that). History is
# trimmed first, then the weakest sources. 5500 keeps a follow-up question (two calls) under
# Groq's free 8K tokens per minute.
RAG_TOKEN_BUDGET=5500
# Most tokens of earlier conversation sent with a question (oldest turns dropped first);
# 0 turns follow-up questions off
RAG_HISTORY_TOKENS=1000

# --- Uploads ------------------------------------------------------------
# Largest PDF/DOCX/TXT upload accepted, in MB; bigger files get a 413 error. The app only
# checks after receiving the file, so the reverse proxy should enforce the same limit.
MAX_UPLOAD_MB=20

# --- Storage ------------------------------------------------------------
DATA_DIR=./data
# Leave empty to use an embedded Chroma in DATA_DIR; set for the Docker service
CHROMA_HOST=
CHROMA_PORT=8000

# --- Web ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# Required for admin-only operations on the public demo (seeding the read-only demo
# workspace). Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Public demo --------------------------------------------------------
# true = a public, login-free demo: each browser only sees its own workspaces and chats (plus
# the read-only demo workspace), visitor workspaces expire, and the limits below apply.
# false (the default) = everything below is off; use this for local dev and client deployments.
# docker-compose.yml turns it on unless PUBLIC_DEMO=false is set in the shell.
PUBLIC_DEMO=false
# Questions per client IP (0 = no limit). Over the limit the API answers 429 with Retry-After.
RATE_LIMIT_CHAT_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_DAY=100
# File uploads per client IP per hour
RATE_LIMIT_UPLOADS_PER_HOUR=10
# New conversations per client IP per hour
RATE_LIMIT_CONVERSATIONS_PER_HOUR=30
# New workspaces per client IP per 24 hours (counted in memory; a restart resets it)
VISITOR_WORKSPACES_PER_IP=3
# Hours until a visitor's workspace (and visitors' chats in the demo workspace) is deleted
VISITOR_WORKSPACE_TTL_HOURS=24
# Most documents in one visitor workspace
MAX_DOCUMENTS_PER_WORKSPACE=10
# Most chunks (sections) one document may index into; longer documents fail before embedding
MAX_DOCUMENT_CHUNKS=300
# Most MB of uploads across all visitor workspaces together
MAX_VISITOR_STORAGE_MB=500
# Most LLM tokens (input + output) all chats may use per UTC day; then questions get a
# "daily limit reached" message. Keep it below the provider's quota (Groq free: 200K/day)
# with room for answers already in flight (one question uses up to ~2x RAG_TOKEN_BUDGET).
DAILY_TOKEN_CAP=150000
# Minutes between sweeps that delete expired visitor workspaces
CLEANUP_INTERVAL_MINUTES=10

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
# true = one JSON object per line (for servers); false = readable text (for local dev)
LOG_JSON=true
