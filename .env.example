# Copy to .env and fill in. Never commit .env.

# --- Chat model ---------------------------------------------------------
# Which provider answers questions: "anthropic" or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Embeddings ---------------------------------------------------------
# "local" = sentence-transformers on CPU (free, no key, ~1GB RAM)
# "openai" = text-embedding-3-small (needs OPENAI_API_KEY, low memory)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Storage ------------------------------------------------------------
DATA_DIR=./data
# Leave empty to use an embedded Chroma in DATA_DIR; set for the Docker service
CHROMA_HOST=
CHROMA_PORT=8000

# --- Web ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# Required for admin-only operations on the public demo
ADMIN_API_KEY=

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
# true = one JSON object per line (for servers); false = readable text (for local dev)
LOG_JSON=true
