# Copy to .env and fill in. Never commit .env.

# --- Chat model ---------------------------------------------------------
# Which provider answers questions: "anthropic" or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Embeddings ---------------------------------------------------------
# "local" = sentence-transformers on CPU (free, no key, ~1GB RAM)
# "openai" = text-embedding-3-small (needs OPENAI_API_KEY, low memory)
EMBEDDING_PROVIDER=local
# bge-small-en-v1.5: MIT licence, 384 dimensions, 512-token input limit
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chunking -----------------------------------------------------------
# Estimated tokens per chunk and how many are repeated between neighbouring chunks.
# Keep the size well under the embedding model's input limit (512 for bge-small) or the
# end of each chunk is silently cut off when it is embedded. Changing these means
# re-indexing existing documents.
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# --- Uploads ------------------------------------------------------------
# Largest PDF/DOCX/TXT upload accepted, in MB; bigger files get a 413 error. The app only
# checks after receiving the file, so the reverse proxy should enforce the same limit.
MAX_UPLOAD_MB=20

# --- Storage ------------------------------------------------------------
DATA_DIR=./data
# Leave empty to use an embedded Chroma in DATA_DIR; set for the Docker service
CHROMA_HOST=
CHROMA_PORT=8000

# --- Web ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# Required for admin-only operations on the public demo
ADMIN_API_KEY=

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
# true = one JSON object per line (for servers); false = readable text (for local dev)
LOG_JSON=true
